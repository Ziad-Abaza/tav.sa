Route::middleware(['web', 'auth', AdminMiddleware::class, SanitizeInputs::class])
    ->prefix('admin')
    ->name('admin.')
    ->group(function () {
        Route::prefix('{{ kebabName }}')->name('{{ kebabName }}.')->group(function () {
            Route::get('/', [{{ name }}Controller::class, 'index'])->name('index');
        });
    });
